# Copia este archivo como .env dentro de backend y completa los dos valores.
# Solo Go debe leer la clave. No la coloques en frontend ni en el chat.
ALMACENAMIENTO=supabase
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REEMPLAZAR
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR
# IDs de Supabase Auth que pueden administrar el sistema, separados por coma.
AUTH_USUARIOS_PERMITIDOS=UUID_DEL_ADMINISTRADOR

# Si tu proyecto usa claves antiguas, puedes dejar SUPABASE_SECRET_KEY vacía
# y definir SUPABASE_SERVICE_ROLE_KEY con la clave service_role (no anon).
# SUPABASE_SERVICE_ROLE_KEY=

ORIGEN_FRONTEND=http://localhost:3000

# Para seguir usando el archivo local de forma explícita:
# ALMACENAMIENTO=archivo
# ARCHIVO_DATOS=datos/academia.json

# En EC2 directo se conserva el valor local. En contenedores: 0.0.0.0:8080.
# DIRECCION_HTTP=127.0.0.1:8080
# Docker o systemd pueden proporcionar la clave como archivo privado:
# SUPABASE_SECRET_KEY_FILE=/run/secrets/supabase_key

{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Aula: EC2 Amazon Linux 2023, HTTPS y SSH restringido. No requiere Docker ni modifica Supabase.",
  "Parameters": {
    "VpcId": { "Type": "AWS::EC2::VPC::Id", "Description": "VPC con acceso a Internet" },
    "SubnetId": { "Type": "AWS::EC2::Subnet::Id", "Description": "Subred publica de esa VPC, con ruta a Internet Gateway" },
    "KeyName": { "Type": "AWS::EC2::KeyPair::KeyName", "Description": "Par de claves SSH existente en esta region" },
    "AdminCidr": {
      "Type": "String",
      "Description": "Tu IP publica con /32; no se acepta SSH abierto a todo Internet",
      "AllowedPattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/32$"
    },
    "InstanceType": { "Type": "String", "Default": "t3.small", "AllowedValues": ["t3.small", "t3.medium"] },
    "LatestAmiId": {
      "Type": "AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>",
      "Default": "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"
    }
  },
  "Resources": {
    "GrupoSeguridad": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "HTTPS publico y SSH solo desde la IP administradora",
        "VpcId": { "Ref": "VpcId" },
        "SecurityGroupIngress": [
          { "IpProtocol": "tcp", "FromPort": 22, "ToPort": 22, "CidrIp": { "Ref": "AdminCidr" } },
          { "IpProtocol": "tcp", "FromPort": 80, "ToPort": 80, "CidrIp": "0.0.0.0/0" },
          { "IpProtocol": "tcp", "FromPort": 443, "ToPort": 443, "CidrIp": "0.0.0.0/0" }
        ]
      }
    },
    "RolInstancia": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [{ "Effect": "Allow", "Principal": { "Service": ["ec2.amazonaws.com"] }, "Action": ["sts:AssumeRole"] }]
        },
        "ManagedPolicyArns": [{ "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/AmazonSSMManagedInstanceCore" }]
      }
    },
    "PerfilInstancia": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": { "Roles": [{ "Ref": "RolInstancia" }] }
    },
    "Servidor": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": { "Ref": "LatestAmiId" },
        "InstanceType": { "Ref": "InstanceType" },
        "KeyName": { "Ref": "KeyName" },
        "IamInstanceProfile": { "Ref": "PerfilInstancia" },
        "MetadataOptions": { "HttpTokens": "required", "HttpPutResponseHopLimit": 1 },
        "NetworkInterfaces": [{
          "DeviceIndex": "0",
          "AssociatePublicIpAddress": true,
          "SubnetId": { "Ref": "SubnetId" },
          "GroupSet": [{ "Ref": "GrupoSeguridad" }]
        }],
        "BlockDeviceMappings": [{ "DeviceName": "/dev/xvda", "Ebs": { "VolumeSize": 20, "VolumeType": "gp3", "Encrypted": true, "DeleteOnTermination": true } }],
        "Tags": [{ "Key": "Name", "Value": { "Fn::Sub": "${AWS::StackName}-aula" } }],
        "UserData": { "Fn::Base64": { "Fn::Join": ["\n", [
          "#!/bin/bash",
          "set -euo pipefail",
          "dnf install -y unzip tar",
          "command -v curl || dnf install -y curl-minimal",
          "touch /home/ec2-user/aula-servidor-listo"
        ]] } }
      }
    }
  },
  "Outputs": {
    "InstanceId": { "Value": { "Ref": "Servidor" } },
    "PublicIp": { "Value": { "Fn::GetAtt": ["Servidor", "PublicIp"] } },
    "Ssh": { "Value": { "Fn::Sub": "ssh -i TU-CLAVE.pem ec2-user@${Servidor.PublicIp}" } }
  }
}

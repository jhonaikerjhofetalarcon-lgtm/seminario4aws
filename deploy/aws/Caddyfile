{$SITE_ADDRESS} {
	encode zstd gzip
	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
	}
	handle /healthz {
		reverse_proxy 127.0.0.1:8080
	}
	handle /api/* {
		reverse_proxy 127.0.0.1:8080
	}
	handle {
		root * /opt/aula/web
		file_server
	}
}

[Unit]
Description=Aula - React y HTTPS con Caddy
Wants=network-online.target aula-api.service
After=network-online.target aula-api.service

[Service]
Type=simple
User=aula-web
Group=aula-web
WorkingDirectory=/var/lib/aula-web
EnvironmentFile=/etc/aula/web.env
Environment=XDG_DATA_HOME=/var/lib/aula-web
Environment=XDG_CONFIG_HOME=/var/lib/aula-web
ExecStart=/usr/local/bin/caddy run --config /etc/caddy/aula.Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aula-web

[Install]
WantedBy=multi-user.target
